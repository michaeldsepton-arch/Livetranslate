{
  "appId": "app.livetranslate.lecture",
  "appName": "Live Translate",
  "webDir": "www",
  "backgroundColor": "#0F3A52",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0F3A52",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0F3A52"
    }
  }
}
