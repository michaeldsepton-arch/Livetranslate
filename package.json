{
  "name": "lisan",
  "version": "1.0.0",
  "private": true,
  "description": "Live Arabic-to-English lecture translator with Islamic terminology support",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
